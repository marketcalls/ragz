# Copy to .env beside compose.prod.yaml and fill in. The stack refuses to start
# rather than invent a default for anything secret -- a deployment that boots
# with a guessable password is worse than one that does not boot.
#
# Generate each secret with:  openssl rand -base64 32

# --- required ---------------------------------------------------------------

# Owner of the schema. Used ONLY by the one-shot migrate job, which needs DDL.
POSTGRES_PASSWORD=CHANGE_ME

# The role the API, worker and beat actually connect as: DML only, no DDL.
# Separate from the owner on purpose -- a compromised worker cannot drop the
# schema it reads. Created by postgres-init.prod.sh on first boot.
RAGZ_APP_DB_PASSWORD=CHANGE_ME

# MinIO root. Used by the minio-init bootstrap to create the bucket, the policy
# and the app's service account -- and by nothing else afterwards.
MINIO_SECRET_KEY=CHANGE_ME

# The app's own MinIO credentials: scoped to the ragz-documents bucket only.
MINIO_APP_SECRET_KEY=CHANGE_ME

# LiteLLM gateway. SALT_KEY encrypts provider keys in LiteLLM's own store, so
# changing it later makes previously stored provider keys unreadable.
LITELLM_MASTER_KEY=CHANGE_ME
LITELLM_SALT_KEY=CHANGE_ME

# --- optional (defaults shown) ----------------------------------------------

# MINIO_ACCESS_KEY=ragz
# MINIO_APP_ACCESS_KEY=ragz-app
# RAGZ_HTTP_PORT=8080
# RAGZ_VERSION=dev

# Path on the HOST to the KEK, mounted read-only into every app container.
# Losing this file makes every encrypted secret in the database unrecoverable,
# so it is the first thing to back up and the last thing to regenerate.
# RAGZ_KEK_HOST_PATH=./data/ragz_kek
