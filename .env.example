# =============================================================================
# Ragz configuration — copy to `.env` and adjust.
#
# Secrets policy (foundation iron rule 3): the ONLY secrets that belong in this
# file are bootstrap-class credentials needed to reach the database and unlock
# the encryption root. Every OTHER secret — LLM provider API keys, OAuth client
# secrets, web-search keys — is stored ENCRYPTED in Postgres and managed through
# the admin API. Never put those here, in logs, or in source control.
#
# All application settings are prefixed `RAGZ_`. The values below are DEV
# defaults; everything in the SECURITY section MUST be changed before you
# expose an instance to anyone but yourself.
# =============================================================================

# -----------------------------------------------------------------------------
# SECURITY  —  CHANGE EVERY VALUE IN THIS SECTION BEFORE PRODUCTION
# -----------------------------------------------------------------------------

# Encryption root key (KEK).
# Envelope-encrypts every stored secret (provider keys, etc.) at rest with
# AES-256-GCM. This keyfile is the ONE secret that lives outside the database.
#   • Auto-created on first run if the path does not exist.
#   • To generate it yourself (base64url of 32 random bytes):
#       python -c "import base64,secrets,pathlib; \
#         pathlib.Path('./data/ragz_kek').write_bytes(base64.urlsafe_b64encode(secrets.token_bytes(32)))"
#   • BACK IT UP and keep it stable. If you lose this file, every encrypted
#     secret in the database becomes permanently unrecoverable.
RAGZ_KEK_FILE=./data/ragz_kek

# Token pepper  (optional; strongly recommended for production).
# Server-side HMAC key for opaque bearer-token hashes — refresh tokens and
# invitation tokens. When set, those tokens are stored as HMAC-SHA256(pepper,
# token) instead of bare SHA-256, so a read-only database leak cannot verify or
# forge a token hash without this out-of-DB value.
#   • Generate:  openssl rand -hex 32
#   • Empty (default) keeps bare SHA-256 — backward compatible with existing
#     hashes. Rotating a set value logs out all users and voids pending
#     invitations (they simply re-login / get re-invited).
RAGZ_API_KEY_PEPPER=

# LiteLLM proxy admin credential + at-rest salt (bootstrap-class config — the
# proxy's OWN admin keys, NOT LLM provider keys). Change BOTH before production.
#   • Generate each:  openssl rand -hex 32   (keep the "sk-" prefix on the key)
#   • RAGZ_LITELLM_MASTER_KEY must match LITELLM_MASTER_KEY.
LITELLM_MASTER_KEY=sk-ragz-dev-master
LITELLM_SALT_KEY=sk-ragz-dev-salt
RAGZ_LITELLM_MASTER_KEY=sk-ragz-dev-master

# NOTE — the JWT signing key is intentionally NOT configured here. Ragz
# auto-generates it on first run and stores it in the database (app_settings);
# it persists across restarts and needs no operator action.

# -----------------------------------------------------------------------------
# CORE SERVICES  —  connection strings for the backing stores
# -----------------------------------------------------------------------------
RAGZ_DATABASE_URL=postgresql+asyncpg://ragz:ragz@localhost:55432/ragz
RAGZ_REDIS_URL=redis://localhost:56379/0
RAGZ_QDRANT_URL=http://localhost:56333
RAGZ_LITELLM_URL=http://localhost:54000

# Object storage (MinIO / any S3-compatible) for uploaded documents.
# The secret key is a store credential; change it for any shared deployment.
RAGZ_MINIO_ENDPOINT=http://localhost:59000
RAGZ_MINIO_ACCESS_KEY=ragz
RAGZ_MINIO_SECRET_KEY=ragz-dev-123
RAGZ_MINIO_BUCKET=ragz-documents

# -----------------------------------------------------------------------------
# EMBEDDINGS & RERANK
# -----------------------------------------------------------------------------
# embedding_backend: "tei" = real embedding server (semantic, multilingual);
#                    "hash" = deterministic stub, DEV/TEST ONLY (not semantic).
# Use "tei" for real retrieval quality. Each embedding model gets its own
# dimension-sized vector collection, so mixing model dimensions is fine.
RAGZ_TEI_URL=http://localhost:58080
RAGZ_EMBEDDING_BACKEND=tei

# -----------------------------------------------------------------------------
# ENVIRONMENT & OPTIONAL FEATURES
# -----------------------------------------------------------------------------
# "dev" relaxes cookie Secure flags for http://localhost. Use "prod" behind TLS.
RAGZ_ENVIRONMENT=dev

# Optional: Sentry error reporting. Requires `uv sync --group observability`
# (sentry-sdk is not installed by default — zero dependency cost when unset).
# RAGZ_SENTRY_DSN=
