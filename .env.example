# Bootstrap config only — never put secrets here (foundation iron rule 3)
RAGHUB_DATABASE_URL=postgresql+asyncpg://raghub:raghub@localhost:55432/raghub
RAGHUB_REDIS_URL=redis://localhost:56379/0
RAGHUB_ENVIRONMENT=dev
RAGHUB_QDRANT_URL=http://localhost:56333
RAGHUB_MINIO_ENDPOINT=http://localhost:59000
RAGHUB_MINIO_ACCESS_KEY=raghub
RAGHUB_MINIO_SECRET_KEY=raghub123
RAGHUB_MINIO_BUCKET=raghub-documents
RAGHUB_TEI_URL=http://localhost:58080
RAGHUB_EMBEDDING_BACKEND=tei

# KEK keyfile path — the ONLY out-of-DB secret (iron rule 3). Generated by bootstrap.
RAGHUB_KEK_FILE=./data/raghub_kek

# LiteLLM proxy admin credential — bootstrap-class config (dev default; change in prod).
# Provider API keys do NOT go here: they live encrypted in the DB via /admin/secrets.
LITELLM_MASTER_KEY=sk-raghub-dev-master
# encrypts provider keys at rest in litellm's DB — CHANGE IN PROD along with LITELLM_MASTER_KEY
LITELLM_SALT_KEY=sk-raghub-dev-salt
RAGHUB_LITELLM_URL=http://localhost:54000
RAGHUB_LITELLM_MASTER_KEY=sk-raghub-dev-master
